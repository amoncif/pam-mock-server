meta {
  name: Invalid credentials
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/PasswordVault/API/auth/Cyberark/Logon
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
      "username": "{{username}}",
      "password": "deliberately-invalid"
  }
}

tests {
  test("Expected HTTP status", function () { expect(res.getStatus()).to.equal(403); });
}
